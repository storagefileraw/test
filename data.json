e"},{"v":"Demon Tongue (2016)"},{"v":"tt3771510"},{"v":"https://vidsrc.to/embed/movie/tt3771510"},{"v":404582.0,"f":"404582"},{"v":"https://vidsrc.to/embed/movie/404582"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,33)","f":"04:09:33"},{"v":"Demon Tongue"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BMjE3MzQ5MjgwNF5BMl5BanBnXkFtZTgwMjI2NjI2OTE@._V1_.jpg"},{"v":2.5,"f":"2,5"},{"v":2016.0,"f":"2016"},{"v":"Dan Mahon, Gavin Rapp"},{"v":"Horror"},{"v":"Demon Tongue: Directed by Dan Mahon, Gavin Rapp. With Jack Davis, Debbie College, Seth Gontkovic, Jessica Long. Four paranormal research students are sent to an abandoned complex to conduct an investigation into strange occurrences that the locals feel are the results of demonic possessions. These amateur ghost hunters get much more than they bargained for when the power goes out, they hear unearthly noises and discover demons lurking in a hidden basement deep beneath the cold, stone structure that now becomes their prison."}]},{"c":[{"v":"7nwniTDK"},{"v":"movie"},{"v":"Me Before You (2016)"},{"v":"tt2674426"},{"v":"https://vidsrc.to/embed/movie/tt2674426"},{"v":296096.0,"f":"296096"},{"v":"https://vidsrc.to/embed/movie/296096"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,33)","f":"04:09:33"},{"v":"Ein ganzes halbes Jahr"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BN2MwYThmMDEtMzU0Yy00ODhmLTkwYzgtNzFlZGVhYTI5NzUzXkEyXkFqcGdeQXVyMzM4MjM0Nzg@._V1_.jpg"},{"v":7.4,"f":"7,4"},{"v":2016.0,"f":"2016"},{"v":"Thea Sharrock"},{"v":"Drama, Romance"},{"v":"Ein ganzes halbes Jahr: Directed by Thea Sharrock. With Sam Claflin, Vanessa Kirby, Emilia Clarke, Eileen Dunwoodie. A girl in a small town forms an unlikely bond with a recently-paralyzed man she\u0027s taking care of."}]},{"c":[{"v":"ysc2YoJI"},{"v":"movie"},{"v":"Marauders (2016)"},{"v":"tt3963816"},{"v":"https://vidsrc.to/embed/movie/tt3963816"},{"v":359412.0,"f":"359412"},{"v":"https://vidsrc.to/embed/movie/359412"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,33)","f":"04:09:33"},{"v":"Marauders - Die Reichen werden bezahlen"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BODU2OTc1OTgyMF5BMl5BanBnXkFtZTgwOTU4OTMxOTE@._V1_.jpg"},{"v":5.5,"f":"5,5"},{"v":2016.0,"f":"2016"},{"v":"Steven C"},{"v":"Action, Crime, Thriller"},{"v":"Marauders - Die Reichen werden bezahlen: Directed by Steven C. Miller. With Bruce Willis, Christopher Meloni, Dave Bautista, Adrian Grenier. When a bank is hit by a brutal heist, all evidence points to the owner and his high-powered clients. But as a group of FBI agents dig deeper into the case - and the deadly heists continue - it becomes clear that a larger conspiracy is at play."}]},{"c":[{"v":"3IEQrdfj"},{"v":"movie"},{"v":"Texas Rein (2016)"},{"v":"tt3377240"},{"v":"https://vidsrc.to/embed/movie/tt3377240"},{"v":404764.0,"f":"404764"},{"v":"https://vidsrc.to/embed/movie/404764"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,35)","f":"04:09:35"},{"v":"Texas Rein"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BNjg4MzQwMjQyM15BMl5BanBnXkFtZTgwODAzNjU0NjE@._V1_.jpg"},{"v":4.8,"f":"4,8"},{"v":2016.0,"f":"2016"},{"v":"Durrell Nelson"},{"v":"Family"},{"v":"Texas Rein: Directed by Durrell Nelson. With Erin Bethea, Ben Davies, Greg Perrow, Lynne Ashe. An all-American story that explores the family dynamic when a prodigal daughter returns home. Cassie Roberts, an ex-rodeo queen turned single mom, has been running from her past and a long trail of bad decisions until she gets an urgent call to return home for her ailing father, Marvin. Cassie plans to stay only long enough to help her father get back on his feet. But when she sees Splash, her father\u0027s prize-winning quarter horse, her plans change. Cassie wants to see Splash compete in the International Equestrian Games and she wants the best trainer in east Texas to make it happen. Then she meets Chase Eversoll, a handsome \u0022cowboy\u0022 horse trainer. As their work turns personal, Chase challenges Cassie to let go of her past and reminds her that reconciliation begins with forgiveness. \u0022Texas Rein\u0022 celebrates the gift of family and the hope of second chances."}]},{"c":[{"v":"ym3Xeriy"},{"v":"movie"},{"v":"The Legend of Tarzan (2016)"},{"v":"tt0918940"},{"v":"https://vidsrc.to/embed/movie/tt0918940"},{"v":258489.0,"f":"258489"},{"v":"https://vidsrc.to/embed/movie/258489"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,35)","f":"04:09:35"},{"v":"Legend of Tarzan"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BN2ZhYTRkNzMtOGQ0ZC00YWMxLThlNWEtZDQ5ZDY1NmYzNmJiXkEyXkFqcGdeQXVyMDAwMDAwNA@@._V1_.jpg"},{"v":6.2,"f":"6,2"},{"v":2016.0,"f":"2016"},{"v":"David Yates"},{"v":"Action, Adventure, Drama"},{"v":"Legend of Tarzan: Directed by David Yates. With Alexander Skarsgård, Rory J Saper, Christian Stevens, Christoph Waltz. Tarzan, having acclimated to life in London, is called back to his former home in the jungle to investigate the activities at a mining encampment."}]},{"c":[{"v":"F6CQ0RIN"},{"v":"movie"},{"v":"Shark Exorcist (2015)"},{"v":"tt3120314"},{"v":"https://vidsrc.to/embed/movie/tt3120314"},{"v":387396.0,"f":"387396"},{"v":"https://vidsrc.to/embed/movie/387396"},{"v":"Date(2024,6,29)","f":"2024-07-29"},{"v":"Date(1899,11,30,4,9,36)","f":"04:09:36"},{"v":"Shark Exorcist"},{"v":"movies"},{"v":"https://m.media-amazon.com/images/M/MV5BYzc1Mzg3ZmEtZDkzYy00YWJmLThhY2UtZTRmOWZiYTRiYTY1XkEyXkFqcGdeQXVyNTQ2OTMwMjc@._V1_.jpg"},{"v":1.3,"f":"1,3"},{"v":2014.0,"f":"2014"},{"v":"Donald Farmer"},{"v":"Action, Comedy, Fantasy"},{"v":"Shark Exorcist: Directed by Donald Farmer. With Angela Kerecz, Bobby Kerecz, Channing Dodson, Madison Carney. A demonic nun unleashes holy hell when she summons the devil to possess a great white shark."}]},{"c":[{"v":"i17mzOvL"},{"v":"movie"},{"v":"Flowers (2015)"},{"v":"tt4248930"},{"v":"https://vidsrc.to/embed/mo